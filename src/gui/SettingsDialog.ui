<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SettingsDialog</class>
 <widget class="QDialog" name="SettingsDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>560</width><height>520</height></rect>
  </property>
  <property name="windowTitle"><string>Receiver settings</string></property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QTabWidget" name="tabs">
     <property name="currentIndex"><number>0</number></property>
     <!-- ============================================================ Input -->
     <widget class="QWidget" name="inputTab">
      <attribute name="title"><string>Input</string></attribute>
      <layout class="QFormLayout" name="inputForm">
       <item row="0" column="0"><widget class="QLabel" name="formatLabel"><property name="text"><string>Sample format</string></property></widget></item>
       <item row="0" column="1">
        <widget class="QComboBox" name="formatCombo">
         <item><property name="text"><string>int8 real</string></property></item>
         <item><property name="text"><string>uint8 real (offset binary)</string></property></item>
         <item><property name="text"><string>int16 real (little endian)</string></property></item>
         <item><property name="text"><string>int8 complex I/Q interleaved</string></property></item>
         <item><property name="text"><string>int16 complex I/Q interleaved</string></property></item>
         <item><property name="text"><string>2-bit real, packed</string></property></item>
        </widget>
       </item>
       <item row="1" column="0"><widget class="QLabel" name="fsLabel"><property name="text"><string>Sampling frequency</string></property></widget></item>
       <item row="1" column="1">
        <widget class="QDoubleSpinBox" name="fsSpin">
         <property name="suffix"><string> MHz</string></property>
         <property name="decimals"><number>6</number></property>
         <property name="minimum"><double>0.100000000000000</double></property>
         <property name="maximum"><double>500.000000000000000</double></property>
         <property name="singleStep"><double>0.001000000000000</double></property>
        </widget>
       </item>
       <item row="2" column="0"><widget class="QLabel" name="ifLabel"><property name="text"><string>Intermediate frequency</string></property></widget></item>
       <item row="2" column="1">
        <widget class="QDoubleSpinBox" name="ifSpin">
         <property name="suffix"><string> MHz</string></property>
         <property name="decimals"><number>6</number></property>
         <property name="minimum"><double>-250.000000000000000</double></property>
         <property name="maximum"><double>500.000000000000000</double></property>
         <property name="singleStep"><double>0.001000000000000</double></property>
        </widget>
       </item>
       <item row="3" column="0"><widget class="QLabel" name="skipLabel"><property name="text"><string>Skip at file start</string></property></widget></item>
       <item row="3" column="1">
        <widget class="QSpinBox" name="skipSpin">
         <property name="suffix"><string> bytes</string></property>
         <property name="maximum"><number>2000000000</number></property>
        </widget>
       </item>
       <item row="4" column="0"><widget class="QLabel" name="msProcessLabel"><property name="text"><string>Data to process</string></property></widget></item>
       <item row="4" column="1">
        <widget class="QSpinBox" name="msProcessSpin">
         <property name="specialValueText"><string>whole file</string></property>
         <property name="suffix"><string> ms</string></property>
         <property name="maximum"><number>100000000</number></property>
        </widget>
       </item>
       <item row="5" column="1"><widget class="QPushButton" name="parseButton"><property name="text"><string>Re-read fs / IF / format from file name</string></property></widget></item>
       <item row="6" column="0"><widget class="QLabel" name="derivedTitle"><property name="text"><string>Derived</string></property></widget></item>
       <item row="6" column="1"><widget class="QLabel" name="derivedLabel"><property name="wordWrap"><bool>true</bool></property></widget></item>
      </layout>
     </widget>
     <!-- ============================================================ Acquisition -->
     <widget class="QWidget" name="acqTab">
      <attribute name="title"><string>Acquisition</string></attribute>
      <layout class="QFormLayout" name="acqForm">
       <item row="0" column="0"><widget class="QLabel" name="prnsLabel"><property name="text"><string>GPS PRNs to search</string></property></widget></item>
       <item row="0" column="1"><widget class="QLineEdit" name="prnsEdit"><property name="toolTip"><string>Comma separated list or ranges, e.g. 1-32 or 1,3,5-9</string></property></widget></item>
       <item row="1" column="0"><widget class="QLabel" name="acqStartLabel"><property name="text"><string>Acquisition data start</string></property></widget></item>
       <item row="1" column="1"><widget class="QSpinBox" name="acqStartSpin"><property name="suffix"><string> ms</string></property><property name="maximum"><number>1000000</number></property></widget></item>
       <item row="2" column="0"><widget class="QLabel" name="acqBandLabel"><property name="text"><string>Doppler search band (+/-)</string></property></widget></item>
       <item row="2" column="1"><widget class="QDoubleSpinBox" name="acqBandSpin"><property name="suffix"><string> Hz</string></property><property name="decimals"><number>0</number></property><property name="minimum"><double>500.000000000000000</double></property><property name="maximum"><double>50000.000000000000000</double></property><property name="singleStep"><double>500.000000000000000</double></property></widget></item>
       <item row="3" column="0"><widget class="QLabel" name="acqStepLabel"><property name="text"><string>Doppler bin width</string></property></widget></item>
       <item row="3" column="1"><widget class="QDoubleSpinBox" name="acqStepSpin"><property name="suffix"><string> Hz</string></property><property name="decimals"><number>0</number></property><property name="minimum"><double>50.000000000000000</double></property><property name="maximum"><double>5000.000000000000000</double></property><property name="singleStep"><double>50.000000000000000</double></property></widget></item>
       <item row="4" column="0"><widget class="QLabel" name="acqNonCohLabel"><property name="text"><string>Non-coherent integration</string></property></widget></item>
       <item row="4" column="1"><widget class="QSpinBox" name="acqNonCohSpin"><property name="suffix"><string> ms</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>20</number></property></widget></item>
       <item row="5" column="0"><widget class="QLabel" name="acqThrLabel"><property name="text"><string>Detection threshold (peak ratio)</string></property></widget></item>
       <item row="5" column="1"><widget class="QDoubleSpinBox" name="acqThrSpin"><property name="minimum"><double>1.000000000000000</double></property><property name="maximum"><double>20.000000000000000</double></property><property name="singleStep"><double>0.100000000000000</double></property></widget></item>
       <item row="6" column="0"><widget class="QLabel" name="fineMsLabel"><property name="text"><string>Fine frequency data length</string></property></widget></item>
       <item row="6" column="1"><widget class="QSpinBox" name="fineMsSpin"><property name="suffix"><string> ms</string></property><property name="minimum"><number>10</number></property><property name="maximum"><number>200</number></property></widget></item>
       <item row="7" column="0"><widget class="QLabel" name="constellationLabel"><property name="text"><string>Constellations</string></property></widget></item>
       <item row="7" column="1">
        <widget class="QComboBox" name="constellationCombo">
         <item><property name="text"><string>GPS + Galileo</string></property></item>
         <item><property name="text"><string>GPS only</string></property></item>
         <item><property name="text"><string>Galileo only</string></property></item>
         <item><property name="text"><string>GLONASS only (recording centred on 1602 MHz)</string></property></item>
        </widget>
       </item>
       <item row="8" column="0"><widget class="QLabel" name="galNonCohLabel"><property name="text"><string>Galileo E1 non-coherent integration</string></property></widget></item>
       <item row="8" column="1"><widget class="QSpinBox" name="galNonCohSpin"><property name="suffix"><string> x 4 ms</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>25</number></property></widget></item>
      </layout>
     </widget>
     <!-- ============================================================ Tracking -->
     <widget class="QWidget" name="trkTab">
      <attribute name="title"><string>Tracking</string></attribute>
      <layout class="QFormLayout" name="trkForm">
       <item row="0" column="0"><widget class="QLabel" name="channelsLabel"><property name="text"><string>Channels per constellation</string></property></widget></item>
       <item row="0" column="1"><widget class="QSpinBox" name="channelsSpin"><property name="minimum"><number>1</number></property><property name="maximum"><number>32</number></property></widget></item>
       <item row="1" column="0"><widget class="QLabel" name="pllBwLabel"><property name="text"><string>PLL noise bandwidth</string></property></widget></item>
       <item row="1" column="1"><widget class="QDoubleSpinBox" name="pllBwSpin"><property name="suffix"><string> Hz</string></property><property name="decimals"><number>1</number></property><property name="minimum"><double>1.000000000000000</double></property><property name="maximum"><double>100.000000000000000</double></property></widget></item>
       <item row="2" column="0"><widget class="QLabel" name="pllZetaLabel"><property name="text"><string>PLL damping ratio</string></property></widget></item>
       <item row="2" column="1"><widget class="QDoubleSpinBox" name="pllZetaSpin"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.300000000000000</double></property><property name="maximum"><double>2.000000000000000</double></property><property name="singleStep"><double>0.050000000000000</double></property></widget></item>
       <item row="3" column="0"><widget class="QLabel" name="fllBwLabel"><property name="text"><string>FLL-assist noise bandwidth</string></property></widget></item>
       <item row="3" column="1"><widget class="QDoubleSpinBox" name="fllBwSpin"><property name="suffix"><string> Hz</string></property><property name="decimals"><number>1</number></property><property name="maximum"><double>50.000000000000000</double></property></widget></item>
       <item row="4" column="0"><widget class="QLabel" name="fllMsLabel"><property name="text"><string>FLL-assist duration</string></property></widget></item>
       <item row="4" column="1"><widget class="QSpinBox" name="fllMsSpin"><property name="suffix"><string> ms</string></property><property name="maximum"><number>100000</number></property></widget></item>
       <item row="5" column="0"><widget class="QLabel" name="dllBwLabel"><property name="text"><string>DLL noise bandwidth</string></property></widget></item>
       <item row="5" column="1"><widget class="QDoubleSpinBox" name="dllBwSpin"><property name="suffix"><string> Hz</string></property><property name="minimum"><double>0.100000000000000</double></property><property name="maximum"><double>20.000000000000000</double></property><property name="singleStep"><double>0.100000000000000</double></property></widget></item>
       <item row="6" column="0"><widget class="QLabel" name="dllZetaLabel"><property name="text"><string>DLL damping ratio</string></property></widget></item>
       <item row="6" column="1"><widget class="QDoubleSpinBox" name="dllZetaSpin"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.300000000000000</double></property><property name="maximum"><double>2.000000000000000</double></property><property name="singleStep"><double>0.050000000000000</double></property></widget></item>
       <item row="7" column="0"><widget class="QLabel" name="dllSpacingLabel"><property name="text"><string>Early/late offset from prompt</string></property></widget></item>
       <item row="7" column="1"><widget class="QDoubleSpinBox" name="dllSpacingSpin"><property name="suffix"><string> chips</string></property><property name="decimals"><number>3</number></property><property name="minimum"><double>0.050000000000000</double></property><property name="maximum"><double>1.000000000000000</double></property><property name="singleStep"><double>0.050000000000000</double></property></widget></item>
       <item row="8" column="1"><widget class="QCheckBox" name="aidingCheck"><property name="text"><string>Carrier-aided DLL</string></property></widget></item>
       <item row="9" column="0"><widget class="QLabel" name="cn0WinLabel"><property name="text"><string>C/N0 estimator window</string></property></widget></item>
       <item row="9" column="1"><widget class="QSpinBox" name="cn0WinSpin"><property name="suffix"><string> ms</string></property><property name="minimum"><number>20</number></property><property name="maximum"><number>2000</number></property></widget></item>
       <item row="10" column="0"><widget class="QLabel" name="galDllSpacingLabel"><property name="text"><string>Galileo E1 early/late offset</string></property></widget></item>
       <item row="10" column="1"><widget class="QDoubleSpinBox" name="galDllSpacingSpin"><property name="suffix"><string> chips</string></property><property name="decimals"><number>3</number></property><property name="minimum"><double>0.05</double></property><property name="maximum"><double>0.25</double></property><property name="singleStep"><double>0.01</double></property></widget></item>
      </layout>
     </widget>
     <!-- ============================================================ Navigation -->
     <widget class="QWidget" name="navTab">
      <attribute name="title"><string>Navigation</string></attribute>
      <layout class="QFormLayout" name="navForm">
       <item row="0" column="0"><widget class="QLabel" name="bitStartLabel"><property name="text"><string>Ignore pull-in before</string></property></widget></item>
       <item row="0" column="1"><widget class="QSpinBox" name="bitStartSpin"><property name="suffix"><string> ms</string></property><property name="maximum"><number>100000</number></property></widget></item>
       <item row="1" column="0"><widget class="QLabel" name="navPeriodLabel"><property name="text"><string>Navigation solution period</string></property></widget></item>
       <item row="1" column="1"><widget class="QSpinBox" name="navPeriodSpin"><property name="suffix"><string> ms</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>60000</number></property></widget></item>
       <item row="2" column="0"><widget class="QLabel" name="elMaskLabel"><property name="text"><string>Elevation mask</string></property></widget></item>
       <item row="2" column="1"><widget class="QDoubleSpinBox" name="elMaskSpin"><property name="suffix"><string> deg</string></property><property name="decimals"><number>1</number></property><property name="minimum"><double>-10.000000000000000</double></property><property name="maximum"><double>60.000000000000000</double></property></widget></item>
       <item row="3" column="0"><widget class="QLabel" name="minCn0Label"><property name="text"><string>Minimum C/N0 for use</string></property></widget></item>
       <item row="3" column="1"><widget class="QDoubleSpinBox" name="minCn0Spin"><property name="suffix"><string> dB-Hz</string></property><property name="decimals"><number>1</number></property><property name="maximum"><double>60.000000000000000</double></property></widget></item>
       <item row="4" column="1"><widget class="QCheckBox" name="ionoCheck"><property name="text"><string>Klobuchar ionosphere (if subframe 4 page 18 decoded)</string></property></widget></item>
       <item row="5" column="1"><widget class="QCheckBox" name="tropoCheck"><property name="text"><string>Saastamoinen troposphere</string></property></widget></item>
       <item row="6" column="1"><widget class="QCheckBox" name="earthRotCheck"><property name="text"><string>Earth rotation (Sagnac) correction</string></property></widget></item>
       <item row="7" column="1"><widget class="QCheckBox" name="elWeightCheck"><property name="text"><string>Elevation-dependent weighting (sin^2 el)</string></property></widget></item>
       <item row="8" column="0"><widget class="QLabel" name="dopSignLabel"><property name="text"><string>IF Doppler sign</string></property></widget></item>
       <item row="8" column="1">
        <widget class="QComboBox" name="dopSignCombo">
         <item><property name="text"><string>Auto-detect</string></property></item>
         <item><property name="text"><string>Normal (low-side LO)</string></property></item>
         <item><property name="text"><string>Inverted spectrum (high-side LO)</string></property></item>
        </widget>
       </item>
      </layout>
     </widget>
     <!-- ============================================================ Live -->
     <widget class="QWidget" name="liveTab">
      <attribute name="title"><string>Live</string></attribute>
      <!-- The settings of each piece of equipment sit in a group whose title box shows or hides them (see
           SettingsDialog.cpp), so that the tab fits on a screen -->
      <layout class="QVBoxLayout" name="liveLayout">
       <item>
        <layout class="QFormLayout" name="liveForm">
         <item row="0" column="0"><widget class="QLabel" name="liveSourceLabel"><property name="text"><string>Live source</string></property></widget></item>
         <item row="0" column="1">
          <widget class="QComboBox" name="liveSourceCombo">
           <item><property name="text"><string>USRP (through the UHD driver)</string></property></item>
           <item><property name="text"><string>Replay the open recording in real time</string></property></item>
           <item><property name="text"><string>Signal Hound SM200 (through sm_api.dll)</string></property></item>
           <item><property name="text"><string>GPSSim simulator (over TCP)</string></property></item>
           <item><property name="text"><string>HackRF One (through hackrf.dll)</string></property></item>
          </widget>
         </item>
         <item row="1" column="0"><widget class="QLabel" name="centerLabel"><property name="text"><string>Centre frequency</string></property></widget></item>
         <item row="1" column="1"><widget class="QDoubleSpinBox" name="centerSpin"><property name="toolTip"><string>For a USRP or a HackRF</string></property><property name="suffix"><string> MHz</string></property><property name="decimals"><number>6</number></property><property name="minimum"><double>1.000000000000000</double></property><property name="maximum"><double>6000.000000000000000</double></property></widget></item>
         <item row="2" column="0"><widget class="QLabel" name="rateLabel"><property name="text"><string>Sample rate</string></property></widget></item>
         <item row="2" column="1"><widget class="QDoubleSpinBox" name="rateSpin"><property name="toolTip"><string>Complex samples per second, for a USRP or a HackRF. GPS works from 2 MS/s, Galileo needs 4 MS/s. The N200 gives 100 MHz divided by an integer and reports the rate it actually set; a HackRF takes any rate from 2 to 20 MS/s.</string></property><property name="suffix"><string> MS/s</string></property><property name="decimals"><number>3</number></property><property name="minimum"><double>0.500000000000000</double></property><property name="maximum"><double>50.000000000000000</double></property><property name="singleStep"><double>0.500000000000000</double></property></widget></item>
         <item row="3" column="0"><widget class="QLabel" name="loOffsetLabel"><property name="text"><string>LO offset</string></property></widget></item>
         <item row="3" column="1"><widget class="QDoubleSpinBox" name="loOffsetSpin"><property name="toolTip"><string>Tunes the LO this far from the centre, which keeps its leakage out of the band. A USRP's digital down-converter makes up the difference; with a HackRF the band then sits at this IF.</string></property><property name="suffix"><string> MHz</string></property><property name="decimals"><number>3</number></property><property name="minimum"><double>-100.000000000000000</double></property><property name="maximum"><double>100.000000000000000</double></property></widget></item>
         <item row="4" column="1"><widget class="QCheckBox" name="recordCheck"><property name="text"><string>Record the samples to disk (20 MB/s at 5 MS/s)</string></property></widget></item>
         <item row="5" column="0"><widget class="QLabel" name="recordDirLabel"><property name="text"><string>Recording folder</string></property></widget></item>
         <item row="5" column="1"><widget class="QLineEdit" name="recordDirEdit"/></item>
        </layout>
       </item>
       <item>
        <widget class="QGroupBox" name="usrpGroup">
         <property name="title"><string>USRP N200 (UHD)</string></property>
         <property name="checkable"><bool>true</bool></property>
         <property name="checked"><bool>false</bool></property>
         <layout class="QVBoxLayout" name="usrpGroupLayout">
          <item>
           <widget class="QWidget" name="usrpBox">
            <layout class="QFormLayout" name="usrpForm">
             <property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property>
             <item row="0" column="0"><widget class="QLabel" name="deviceArgsLabel"><property name="text"><string>Device address</string></property></widget></item>
             <item row="0" column="1"><widget class="QLineEdit" name="deviceArgsEdit"><property name="toolTip"><string>UHD device arguments, e.g. addr=192.168.10.2 (the N200 default). recv_buff_size=50000000 can be appended to help against overflows.</string></property></widget></item>
             <item row="1" column="0"><widget class="QLabel" name="gainLabel"><property name="text"><string>Gain</string></property></widget></item>
             <item row="1" column="1"><widget class="QDoubleSpinBox" name="gainSpin"><property name="suffix"><string> dB</string></property><property name="decimals"><number>1</number></property><property name="maximum"><double>120.000000000000000</double></property></widget></item>
             <item row="2" column="0"><widget class="QLabel" name="antennaLabel"><property name="text"><string>Antenna port</string></property></widget></item>
             <item row="2" column="1"><widget class="QLineEdit" name="antennaEdit"><property name="toolTip"><string>Empty = the daughterboard's default, e.g. RX2 or TX/RX on a WBX or SBX (RF 2 and RF 1 on an N200's front panel)</string></property></widget></item>
             <item row="3" column="0"><widget class="QLabel" name="subdevLabel"><property name="text"><string>Subdevice</string></property></widget></item>
             <item row="3" column="1"><widget class="QLineEdit" name="subdevEdit"><property name="toolTip"><string>Empty = the default, e.g. A:0</string></property></widget></item>
             <item row="4" column="0"><widget class="QLabel" name="clockLabel"><property name="text"><string>Clock source</string></property></widget></item>
             <item row="4" column="1">
              <widget class="QComboBox" name="clockCombo">
               <property name="editable"><bool>true</bool></property>
               <item><property name="text"><string>internal</string></property></item>
               <item><property name="text"><string>external</string></property></item>
               <item><property name="text"><string>gpsdo</string></property></item>
               <item><property name="text"><string>mimo</string></property></item>
              </widget>
             </item>
             <item row="5" column="0"><widget class="QLabel" name="bandwidthLabel"><property name="text"><string>Analog bandwidth</string></property></widget></item>
             <item row="5" column="1"><widget class="QDoubleSpinBox" name="bandwidthSpin"><property name="specialValueText"><string>daughterboard default</string></property><property name="suffix"><string> MHz</string></property><property name="decimals"><number>3</number></property><property name="maximum"><double>200.000000000000000</double></property></widget></item>
             <item row="6" column="0"><widget class="QLabel" name="uhdPathLabel"><property name="text"><string>uhd.dll</string></property></widget></item>
             <item row="6" column="1"><widget class="QLineEdit" name="uhdPathEdit"><property name="toolTip"><string>Empty = look in UHD_PKG_PATH, Program Files and PATH</string></property></widget></item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="hackrfGroup">
         <property name="title"><string>HackRF One</string></property>
         <property name="checkable"><bool>true</bool></property>
         <property name="checked"><bool>false</bool></property>
         <layout class="QVBoxLayout" name="hackrfGroupLayout">
          <item>
           <widget class="QWidget" name="hackrfBox">
            <layout class="QFormLayout" name="hackrfForm">
             <property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property>
             <item row="0" column="0"><widget class="QLabel" name="hackrfSerialLabel"><property name="text"><string>Serial number</string></property></widget></item>
             <item row="0" column="1"><widget class="QLineEdit" name="hackrfSerialEdit"><property name="toolTip"><string>Or its last digits. Empty = the first HackRF found.</string></property></widget></item>
             <item row="1" column="0"><widget class="QLabel" name="hackrfLnaLabel"><property name="text"><string>LNA gain</string></property></widget></item>
             <item row="1" column="1"><widget class="QSpinBox" name="hackrfLnaSpin"><property name="suffix"><string> dB</string></property><property name="maximum"><number>40</number></property><property name="singleStep"><number>8</number></property></widget></item>
             <item row="2" column="0"><widget class="QLabel" name="hackrfVgaLabel"><property name="text"><string>VGA gain</string></property></widget></item>
             <item row="2" column="1"><widget class="QSpinBox" name="hackrfVgaSpin"><property name="suffix"><string> dB</string></property><property name="maximum"><number>62</number></property><property name="singleStep"><number>2</number></property></widget></item>
             <item row="3" column="1"><widget class="QCheckBox" name="hackrfAmpCheck"><property name="toolTip"><string>Needed when the antenna's noise is not well above the HackRF's own: switching the antenna power on should raise the level by several dB.</string></property><property name="text"><string>RF amplifier (+14 dB)</string></property></widget></item>
             <item row="4" column="1"><widget class="QCheckBox" name="hackrfPowerCheck"><property name="toolTip"><string>Never with a cable to another radio or a signal generator: the DC would go into it.</string></property><property name="text"><string>Antenna power (3.3 V, for an active antenna)</string></property></widget></item>
             <item row="5" column="0"><widget class="QLabel" name="hackrfPpmLabel"><property name="text"><string>Crystal error</string></property></widget></item>
             <item row="5" column="1"><widget class="QDoubleSpinBox" name="hackrfPpmSpin"><property name="toolTip"><string>Positive when the HackRF runs fast. The tuning and the sample rate are corrected by it.</string></property><property name="suffix"><string> ppm</string></property><property name="decimals"><number>2</number></property><property name="minimum"><double>-100.000000000000000</double></property><property name="maximum"><double>100.000000000000000</double></property><property name="singleStep"><double>0.100000000000000</double></property></widget></item>
             <item row="6" column="0"><widget class="QLabel" name="hackrfPathLabel"><property name="text"><string>hackrf.dll</string></property></widget></item>
             <item row="6" column="1"><widget class="QLineEdit" name="hackrfPathEdit"><property name="toolTip"><string>Empty = next to the program, then PATH. libusb-1.0.dll must sit beside it.</string></property></widget></item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="smGroup">
         <property name="title"><string>Signal Hound SM200</string></property>
         <property name="checkable"><bool>true</bool></property>
         <property name="checked"><bool>false</bool></property>
         <layout class="QVBoxLayout" name="smGroupLayout">
          <item>
           <widget class="QWidget" name="smBox">
            <layout class="QFormLayout" name="smForm">
             <property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property>
             <item row="0" column="0"><widget class="QLabel" name="smPathLabel"><property name="text"><string>sm_api.dll</string></property></widget></item>
             <item row="0" column="1"><widget class="QLineEdit" name="smPathEdit"><property name="toolTip"><string>Path of sm_api.dll from the Signal Hound SDK. Empty = next to the program, then the system path.</string></property></widget></item>
             <item row="1" column="0"><widget class="QLabel" name="smCenterLabel"><property name="text"><string>Centre frequency</string></property></widget></item>
             <item row="1" column="1"><widget class="QDoubleSpinBox" name="smCenterSpin"><property name="toolTip"><string>41.5 MHz is usable at 50 MS/s. 1590 MHz covers L1/E1 and every GLONASS channel; 1585 MHz clips channel +6.</string></property><property name="suffix"><string> MHz</string></property><property name="decimals"><number>3</number></property><property name="minimum"><double>1500.000000000000000</double></property><property name="maximum"><double>1700.000000000000000</double></property></widget></item>
             <item row="2" column="0"><widget class="QLabel" name="smRefLabel"><property name="text"><string>Reference level</string></property></widget></item>
             <item row="2" column="1"><widget class="QDoubleSpinBox" name="smRefSpin"><property name="suffix"><string> dBm</string></property><property name="minimum"><double>-130.000000000000000</double></property><property name="maximum"><double>20.000000000000000</double></property></widget></item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="tcpGroup">
         <property name="title"><string>GPSSim stream (TCP)</string></property>
         <property name="checkable"><bool>true</bool></property>
         <property name="checked"><bool>false</bool></property>
         <layout class="QVBoxLayout" name="tcpGroupLayout">
          <item>
           <widget class="QWidget" name="tcpBox">
            <layout class="QFormLayout" name="tcpForm">
             <property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property>
             <item row="0" column="0"><widget class="QLabel" name="tcpHostLabel"><property name="text"><string>Address</string></property></widget></item>
             <item row="0" column="1"><widget class="QLineEdit" name="tcpHostEdit"/></item>
             <item row="1" column="0"><widget class="QLabel" name="tcpPortLabel"><property name="text"><string>Port</string></property></widget></item>
             <item row="1" column="1"><widget class="QSpinBox" name="tcpPortSpin"><property name="minimum"><number>1024</number></property><property name="maximum"><number>65535</number></property></widget></item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="processingGroup">
         <property name="title"><string>Processing</string></property>
         <property name="checkable"><bool>true</bool></property>
         <property name="checked"><bool>false</bool></property>
         <layout class="QVBoxLayout" name="processingGroupLayout">
          <item>
           <widget class="QWidget" name="processingBox">
            <layout class="QFormLayout" name="processingForm">
             <property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property>
             <item row="0" column="0"><widget class="QLabel" name="ringLabel"><property name="text"><string>Sample buffer</string></property></widget></item>
             <item row="0" column="1"><widget class="QSpinBox" name="ringSpin"><property name="suffix"><string> s</string></property><property name="minimum"><number>2</number></property><property name="maximum"><number>120</number></property></widget></item>
             <item row="1" column="0"><widget class="QLabel" name="windowLabel"><property name="text"><string>Tracking history</string></property></widget></item>
             <item row="1" column="1"><widget class="QSpinBox" name="windowSpin"><property name="suffix"><string> s</string></property><property name="minimum"><number>36</number></property><property name="maximum"><number>600</number></property></widget></item>
             <item row="2" column="0"><widget class="QLabel" name="historyLabel"><property name="text"><string>Position history</string></property></widget></item>
             <item row="2" column="1"><widget class="QSpinBox" name="historySpin"><property name="suffix"><string> s</string></property><property name="minimum"><number>10</number></property><property name="maximum"><number>86400</number></property></widget></item>
             <item row="3" column="0"><widget class="QLabel" name="updateLabel"><property name="text"><string>Update every</string></property></widget></item>
             <item row="3" column="1"><widget class="QSpinBox" name="updateSpin"><property name="suffix"><string> ms</string></property><property name="minimum"><number>100</number></property><property name="maximum"><number>10000</number></property><property name="singleStep"><number>100</number></property></widget></item>
             <item row="4" column="0"><widget class="QLabel" name="acqIntervalLabel"><property name="text"><string>Search for satellites every</string></property></widget></item>
             <item row="4" column="1"><widget class="QSpinBox" name="acqIntervalSpin"><property name="suffix"><string> s</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>600</number></property></widget></item>
             <item row="5" column="0"><widget class="QLabel" name="replaySpeedLabel"><property name="text"><string>Replay speed</string></property></widget></item>
             <item row="5" column="1"><widget class="QDoubleSpinBox" name="replaySpeedSpin"><property name="suffix"><string> x</string></property><property name="minimum"><double>0.100000000000000</double></property><property name="maximum"><double>100.000000000000000</double></property></widget></item>
            </layout>
